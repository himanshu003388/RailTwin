---
import '../styles/global.css';
import { AlertBanner } from '../components/ui/AlertBanner';
import { ToastContainer } from '../components/ui/ToastContainer';
import { KeyboardShortcuts } from '../components/ui/KeyboardShortcuts';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
		<link rel="apple-touch-icon" href={`${baseUrl}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>RailTwin AI — Predictive Digital Twin | Indian Railways</title>
		
		<!-- Meta + SEO Details -->
		<meta name="description" content="RailTwin AI is a Predictive Digital Twin for Indian Railway Operations. Real-time delay prediction, cascading disruption analysis, and AI-powered resolution for 7 major routes across India." />
		<meta property="og:title" content="RailTwin AI — Predictive Digital Twin" />
		<meta property="og:description" content="Real-time delay prediction, cascading disruption analysis, and AI-powered resolution for 7 major Indian Railways routes. Pan-India coverage across 36 stations." />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="RailTwin AI — Predictive Digital Twin" />
		<meta name="twitter:description" content="AI-powered Operations Center for Indian Railways. Predict delays before they happen." />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="color-scheme" content="dark light" />

		<!-- Theme Initialization -->
		<script is:inline>
			(function() {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme === 'light' || (!storedTheme && window.matchMedia('(prefers-color-scheme: light)').matches)) {
					document.documentElement.classList.add('light');
				} else {
					document.documentElement.classList.remove('light');
				}
			})();
		</script>

		<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.3.0/dist/maplibre-gl.css" />
		<!-- Load MapLibre JS script with defer -->
		<script defer is:inline src="https://unpkg.com/maplibre-gl@4.3.0/dist/maplibre-gl.js"></script>
	</head>
	<body class="bg-bg-page text-text-primary h-[100dvh] overflow-hidden">
		<!-- Full-page Premium Loading Overlay -->
		<div id="loading-overlay" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center select-none" style="background: var(--color-bg-page); transition: opacity 400ms ease-out;">
			<!-- Animated mesh gradient backdrop -->
			<div class="absolute inset-0 pointer-events-none animate-mesh" style="background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(37,99,235,0.18) 0%, rgba(168,85,247,0.12) 40%, rgba(6,182,212,0.08) 70%, transparent 100%);"></div>
			<!-- Secondary radial for depth -->
			<div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 40% at 20% 80%, rgba(37,99,235,0.06) 0%, transparent 60%);"></div>

			<div class="relative flex flex-col items-center gap-7 animate-slide-up">
				<!-- Logo with glow rings -->
				<div class="relative flex items-center justify-center">
					<!-- Outer glow ring -->
					<div class="absolute w-24 h-24 rounded-2xl opacity-30 animate-breath" style="background: radial-gradient(circle, rgba(37,99,235,0.7), rgba(168,85,247,0.4), transparent); filter: blur(12px);"></div>
					<!-- Icon container -->
					<div
						class="relative w-16 h-16 rounded-2xl flex items-center justify-center animate-breath"
						style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); box-shadow: 0 0 0 4px rgba(37,99,235,0.10), 0 0 32px rgba(37,99,235,0.30), 0 0 60px rgba(168,85,247,0.15), var(--shadow-elevated);"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent-blue); filter: drop-shadow(0 0 8px rgba(37,99,235,0.8));"><path d="M4 22V4c0-.5.2-1 .6-1.4C5 2.2 5.5 2 6 2h12c.5 0 1 .2 1.4.6.4.4.6.9.6 1.4v18"></path><path d="M12 2v20"></path><path d="M4 18h16"></path><path d="M4 14h16"></path><path d="M4 10h16"></path><path d="M4 6h16"></path></svg>
					</div>
				</div>

				<!-- Brand name -->
				<div class="flex flex-col items-center gap-2">
					<div class="flex items-center gap-2.5">
						<span class="text-xl font-bold tracking-tight" style="color: var(--color-text-primary); letter-spacing: -0.03em;">RailTwin</span>
						<span class="px-2 py-0.5 rounded-md text-[10px] font-mono font-bold uppercase tracking-wider" style="background: rgba(168,85,247,0.15); color: var(--color-accent-purple); border: 1px solid rgba(168,85,247,0.25); box-shadow: 0 0 12px rgba(168,85,247,0.2);">AI</span>
					</div>
					<span class="font-mono text-[11px] uppercase tracking-[0.18em]" style="color: var(--color-text-tertiary);">7 Routes · 36 Stations · Pan-India</span>
				</div>

				<!-- Progress Track with shimmer -->
				<div class="flex flex-col items-center gap-2 w-full">
					<div class="w-60 h-[3px] rounded-full overflow-hidden" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border-subtle);">
						<div class="h-full rounded-full animate-shimmer" style="width: 0%; animation: loading-progress 2s cubic-bezier(0.25,0.46,0.45,0.94) forwards, shimmer 1.5s linear infinite;"></div>
					</div>
					<div class="flex items-center gap-1.5">
						<span class="w-1 h-1 rounded-full bg-accent-blue animate-pulse" style="box-shadow: 0 0 6px var(--color-accent-blue);"></span>
						<span id="loading-status" class="font-mono text-[9px] uppercase tracking-widest" style="color: var(--color-text-muted);">Initializing Operations Center</span>
					</div>
				</div>
			</div>
		</div>

		<script is:inline>
			// Cycle loading status messages for a more premium feel
			const loadingMessages = [
				'Connecting to live network',
				'Computing train positions',
				'Syncing national network data',
				'Connecting to live data feeds',
			];
			let msgIdx = 0;
			const statusEl = document.getElementById('loading-status');
			const msgInterval = setInterval(() => {
				msgIdx = (msgIdx + 1) % loadingMessages.length;
				if (statusEl) statusEl.textContent = loadingMessages[msgIdx];
			}, 500);
			setTimeout(() => {
				clearInterval(msgInterval);
				const overlay = document.getElementById('loading-overlay');
				if (overlay) {
					overlay.style.opacity = '0';
					setTimeout(() => {
						overlay.remove();
					}, 400);
				}
			}, 2000);
		</script>

		<AlertBanner client:load />
		<KeyboardShortcuts client:load />
		<slot />
		<ToastContainer client:load />
	</body>
</html>
