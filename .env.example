# RailTwin Backend Configuration

# Gemini AI (required for copilot)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap (required for live weather — app fails gracefully if missing)
# Get a free API key at https://openweathermap.org/api
# Fetches live weather for 5 stations on the Delhi-Howrah corridor
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# JWT Secret (change in production)
JWT_SECRET=railtwin-secret-key-change-in-production
